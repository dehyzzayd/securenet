---
// SecureNet wordmark — hand-built geometric mark (chamfered secure perimeter +
// camera aperture + network hub). Uses currentColor; amber accent is fixed.
interface Props { size?: number; wordmark?: boolean; class?: string; ariaHidden?: boolean }
const { size = 34, wordmark = true, class: cls = '', ariaHidden = false } = Astro.props;
---
<a class:list={['logo', cls]} href="/" aria-label="SecureNet — accueil" aria-hidden={ariaHidden ? 'true' : undefined}>
  <svg class="logo__mark" width={size} height={size} viewBox="0 0 48 48" fill="none" role="img" aria-hidden="true">
    <!-- secured perimeter (chamfered octagon) -->
    <path d="M4 11 L11 4 L37 4 L44 11 L44 37 L37 44 L11 44 L4 37 Z"
          stroke="currentColor" stroke-width="1.6" fill="none" opacity="0.9"/>
    <!-- aperture ring -->
    <path d="M34 24 L31.07 31.07 L24 34 L16.93 31.07 L14 24 L16.93 16.93 L24 14 L31.07 16.93 Z"
          stroke="currentColor" stroke-width="1.4" fill="none"/>
    <!-- spokes / network hub -->
    <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
      <path d="M34 24 L28 24"/>
      <path d="M31.07 31.07 L26.83 26.83"/>
      <path d="M24 34 L24 28"/>
      <path d="M16.93 31.07 L21.17 26.83"/>
      <path d="M14 24 L20 24"/>
      <path d="M24 14 L24 20"/>
      <path d="M31.07 16.93 L26.83 21.17"/>
    </g>
    <!-- amber accent blade -->
    <path d="M16.93 16.93 L21.17 21.17" stroke="#cfa574" stroke-width="1.7" stroke-linecap="round"/>
    <!-- lens -->
    <circle cx="24" cy="24" r="3.4" stroke="currentColor" stroke-width="1.3" fill="none"/>
    <circle cx="24" cy="24" r="1.5" fill="#cfa574"/>
  </svg>
  {wordmark && (
    <span class="logo__word">Secure<span class="logo__word-amber">Net</span></span>
  )}
</a>
<style>
  .logo{display:inline-flex;align-items:center;gap:11px;text-decoration:none;color:inherit}
  .logo__mark{flex:none;display:block}
  .logo__word{font-family:Panchang,Archivo,sans-serif;font-weight:800;text-transform:uppercase;font-size:19px;letter-spacing:.01em;line-height:1;color:currentColor}
  .logo__word-amber{color:var(--amber)}
</style>
