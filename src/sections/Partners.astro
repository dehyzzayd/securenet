---
import Title from '../components/Title.astro';
import { sectors } from '../lib/data';
// Two rows, opposite directions. Duplicated once for a seamless loop.
const rowA = [...sectors, ...sectors];
const rowB = [...sectors.slice().reverse(), ...sectors.slice().reverse()];
---
<section class="partners pad-y" id="confiance">
  <span class="ghost" style="top:-.28em;left:-3%" aria-hidden="true">Confiance</span>
  <div class="container">
    <div class="partners__grid">
      <div>
        <span class="eyebrow eyebrow--ink">Ils nous font confiance</span>
        <Title as="h2" lines={['La sécurité', 'de ceux qui']} accent="nous confient" tone="navy" size="l" />
        <p class="lead">
          Commerçants, syndics, industriels, professions libérales : nos clients n’ont pas
          le même métier, mais tous veulent la même chose — dormir tranquille. Nous
          intervenons pour des structures de toutes tailles, du commerce de quartier au
          site logistique.
        </p>
        <a class="btn" href="/#contact" style="margin-top:30px">
          Rejoindre nos clients
          <svg viewBox="0 0 16 12" fill="none" aria-hidden="true"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
      </div>
      <div class="cframe partners__frame" data-reveal>
        <img src="/media/services/partners.png" alt="Bâtiment commercial sécurisé par SecureNet" loading="lazy" decoding="async" />
        <div class="cframe__chips"><span class="chip">Références sur demande</span></div>
      </div>
    </div>

    <div class="marquee-label">Les secteurs que nous protégeons</div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {rowA.map((s) => <span class="sector-chip">{s}</span>)}
    </div>
  </div>
  <div class="marquee marquee--rev" aria-hidden="true">
    <div class="marquee__track">
      {rowB.map((s) => <span class="sector-chip">{s}</span>)}
    </div>
  </div>
</section>
