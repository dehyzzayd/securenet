---
import Base from '../layouts/Base.astro';
import Title from '../components/Title.astro';
import { brand } from '../lib/data';
export const prerender = true;
---
<Base title="Mentions légales — SecureNet" description="Mentions légales et politique de confidentialité de SecureNet.">
  <section class="pad-y" style="padding-top:calc(var(--header-h) + 80px)">
    <div class="container" style="max-width:820px">
      <span class="eyebrow eyebrow--ink">Informations légales</span>
      <Title as="h1" lines={['Mentions']} accent="légales" tone="navy" size="l" />
      <div class="legal">
        <h2>Éditeur du site</h2>
        <p>{brand.name} — {brand.baseline}. {brand.address}. Téléphone : {brand.phone}. E-mail : {brand.email}.
        <br /><em>SIREN, forme juridique et capital à compléter par l’exploitant.</em></p>

        <h2>Hébergement</h2>
        <p>Hébergeur à préciser (nom, adresse et téléphone de l’hébergeur retenu lors de la mise en ligne).</p>

        <h2>Données personnelles</h2>
        <p>Les informations transmises via les formulaires de contact et de téléchargement (nom, téléphone, e-mail,
        message) sont utilisées uniquement pour répondre à votre demande et vous adresser une proposition
        commerciale. Elles ne sont ni revendues, ni cédées à des tiers.</p>
        <p>Conformément au RGPD, vous disposez d’un droit d’accès, de rectification et de suppression de vos données.
        Pour l’exercer, écrivez à <a href={`mailto:${brand.email}`}>{brand.email}</a>.</p>

        <h2>Cookies</h2>
        <p>Ce site n’utilise pas de cookies publicitaires ni de traceurs tiers. La carte des zones d’intervention
        charge des fonds cartographiques (OpenStreetMap / CARTO) lorsque vous la faites défiler.</p>

        <h2>Propriété intellectuelle</h2>
        <p>L’ensemble des contenus (textes, identité visuelle, illustrations) est la propriété de {brand.name}.
        Toute reproduction sans autorisation est interdite.</p>
      </div>
      <a href="/" class="link-arrow" style="margin-top:30px">← Retour à l’accueil</a>
    </div>
  </section>
  <style>
    .legal{margin-top:36px;display:flex;flex-direction:column;gap:10px}
    .legal h2{font-family:Panchang;font-weight:800;text-transform:uppercase;font-size:19px;color:var(--navy);margin-top:26px}
    .legal p{color:var(--muted);line-height:1.7;max-width:70ch}
    .legal a{color:var(--navy)}
  </style>
</Base>
