# --- SecureNet environment ---
# Base de données locale (libSQL / SQLite fichier). Aucune installation externe requise.
DATABASE_URL="file:./data/securenet.db"

# Envoi d'e-mails (optionnel). Sans clé Resend, les e-mails sont journalisés en console (dev).
RESEND_API_KEY=""
MAIL_TO="contact@securenet.fr"
MAIL_FROM="SecureNet <no-reply@securenet.fr>"

# Accès admin (/admin). Changez ce mot de passe avant toute mise en ligne.
ADMIN_PASSWORD="securenet-admin"
# Secret de signature des sessions admin. Générez une longue chaîne aléatoire.
SESSION_SECRET="change-me-please-a-long-random-string"

# URL publique du site
SITE_URL="http://localhost:3040"

# Clé CARTO Basemaps (carte des zones). Clé publique côté navigateur.
# Gérez-la sur carto.com/basemaps/apikey
PUBLIC_CARTO_KEY="cb1_3waa_1_4ef9f9597e5ad17de85f36b8"
